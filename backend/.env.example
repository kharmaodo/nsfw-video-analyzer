APP_NAME=NSFW Video Analyzer
APP_ENV=development
APP_DEBUG=false
DATABASE_URL=sqlite:///./storage/database/videos.db
SQLITE_BUSY_TIMEOUT_MS=5000
SCRAPER_CONNECT_TIMEOUT_SECONDS=5
SCRAPER_READ_TIMEOUT_SECONDS=15
SCRAPER_MAX_HTML_BYTES=2097152
SCRAPER_MAX_REDIRECTS=5
VIDEO_MAX_SIZE_BYTES=5368709120
VIDEO_REQUIRE_RANGE_REQUESTS=true
VIDEO_ALLOWED_CONTENT_TYPES=video/mp4,video/webm,video/x-matroska,video/quicktime,video/x-msvideo
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe
VIDEO_CLIP_DURATION_SECONDS=300
VIDEO_FRAME_INTERVAL_SECONDS=10
VIDEO_FRAME_WIDTH=384
VIDEO_PROCESS_TIMEOUT_SECONDS=600
VIDEO_TEMPORARY_DIRECTORY=./storage/temporary
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
CELERY_MAX_RETRIES=3
CELERY_RETRY_DELAY_SECONDS=15
NSFW_MODEL_NAME=Falconsai/nsfw_image_detection
NSFW_MODEL_REVISION=ea798c4a93814025af5c7befb6cbf34757ecc7b4
NSFW_THRESHOLD=0.60
NSFW_MIN_POSITIVE_FRAMES=1
NSFW_BATCH_SIZE=8
NSFW_DEVICE=-1
NSFW_CLEANUP_FRAMES=true
HF_HOME=/app/storage/model-cache
API_ALLOWED_HOSTS=localhost,127.0.0.1,testserver,api
API_MAX_REQUEST_BYTES=2097152
